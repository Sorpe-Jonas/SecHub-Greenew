# Copy this file to .env and replace the placeholder values with your actual configuration.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sechub?schema=public"
AUTH_SECRET="replace-with-a-strong-secret"
PASSWORD_ENCRYPTION_SECRET="replace-with-a-strong-secret"

# Optional: Auth0 SSO
AUTH_AUTH0_ID="your-auth0-client-id"
AUTH_AUTH0_SECRET="your-auth0-client-secret"
AUTH_AUTH0_ISSUER="https://your-auth0-domain/"
